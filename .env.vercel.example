# ==============================================================================
# Vercel Production Environment Configuration (Singapore - sin1)
# Copy these values into your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Core Application
APP_NAME="Smart Account POS API"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:IqcGJdQPXFo2D9Dj5Gk1MDLERw7pXriU04YbDdOpwA4=
APP_URL=https://your-backend-app.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

# Serverless Ephemeral Filesystem (Points to writable /tmp)
APP_STORAGE=/tmp/storage
VIEW_COMPILED_PATH=/tmp/storage/framework/views
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (Neon PostgreSQL Singapore ap-southeast-1 - recommend using pooler endpoint)
DB_CONNECTION=pgsql
DB_HOST=ep-small-sea-b3617j9t-pooler.c-4.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
DB_SSLMODE=require
DB_URL="postgresql://neondb_owner:your_neon_password@ep-small-sea-b3617j9t-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Stateless Session & Cache (Serverless friendly)
SESSION_DRIVER=cookie
CACHE_STORE=database
QUEUE_CONNECTION=database

# Dual-Layer Encrypted JWT Security
JWT_SECRET=e4c5929a62bf928430f5b034905d20f9ae1eb8379ea9adef592fd39056cd2493
JWT_ENCRYPTION_KEY=15d52449913afb7b1f8dbacb85f7c8238d3b5243415d0009c1ad4d05ad561254
JWT_ACCESS_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# Edge Security & TLS
FORCE_HTTPS=true
TLS_HSTS_ENABLED=true
ENABLE_GZIP_COMPRESSION=true

# File Storage (Set to s3 if using AWS S3 / Cloudflare R2 / Neon Object Storage)
FILESYSTEM_DISK=local
